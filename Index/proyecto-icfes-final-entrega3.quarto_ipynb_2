      "id": "27abc87a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "fig, axes = plt.subplots(1, 3, figsize=(14, 4))\n",
        "fig.patch.set_facecolor(\"#F8FAFC\")\n",
        "fig.suptitle(\"Fórmulas — Medidas de Localización  (Q1 · Q2 · Q3 · IQR)\",\n",
        "             fontsize=12, fontweight=\"bold\", color=\"#1E293B\", y=1.02)\n",
        "\n",
        "formulas_loc = [\n",
        "    (\"Índice de interpolación\",\n",
        "     r\"$k = (n-1)\\cdot p$\" + \"\\n\" + r\"$i = \\lfloor k \\rfloor, \\quad d = k - i$\",\n",
        "     \"Base del cálculo manual\\nde percentiles.\",\n",
        "     \"#2563EB\"),\n",
        "    (\"Percentil por interpolación lineal\",\n",
        "     r\"$P_p = x_{[i]} + d\\,(x_{[i+1]} - x_{[i]})$\",\n",
        "     \"Aplicado con p=0.25, 0.50, 0.75\\npara obtener Q1, Q2 y Q3.\",\n",
        "     \"#16A34A\"),\n",
        "    (\"Rango intercuartílico\",\n",
        "     r\"$IQR = Q_3 - Q_1$\",\n",
        "     \"Dispersión del 50% central.\\nRobusto ante valores atípicos.\",\n",
        "     \"#DC2626\"),\n",
        "]\n",
        "\n",
        "for ax, (titulo, formula, desc, color) in zip(axes.flat, formulas_loc):\n",
        "    ax.set_facecolor(\"#FFFFFF\")\n",
        "    for sp in ax.spines.values():\n",
