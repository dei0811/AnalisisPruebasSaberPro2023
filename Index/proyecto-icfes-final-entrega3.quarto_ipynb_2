    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "# 1. Fechas\n",
        "if df['ESTU_FECHANACIMIENTO'].dtype == 'object':\n",
        "    df['ESTU_FECHANACIMIENTO'] = pd.to_datetime(\n",
        "        df['ESTU_FECHANACIMIENTO'], format='%d/%m/%Y', errors='coerce')\n",
        "\n",
        "# 2. Extracción numérica\n",
        "for col in ['FAMI_ESTRATOVIVIENDA', 'ESTU_SEMESTRECURSA']:\n",
        "    if df[col].dtype == 'object':\n",
        "        df[col] = df[col].str.extract(r'(\\d+)').astype(float)\n",
        "\n",
        "# 3. Imputación\n",
        "for col in df.select_dtypes(include=[np.number]).columns:\n",
        "    df[col] = df[col].fillna(df[col].median())\n",
        "for col in df.select_dtypes(include=['object']).columns:\n",
        "    if not df[col].mode().empty:\n",
        "        df[col] = df[col].fillna(df[col].mode()[0])\n",
        "\n",
        "# 4. Booleanos\n",
        "for col in ['ESTU_PAGOMATRICULACREDITO','ESTU_PAGOMATRICULAPROPIO',\n",
        "            'ESTU_PAGOMATRICULABECA','ESTU_PAGOMATRICULAPADRES',\n",
        "            'FAMI_TIENECOMPUTADOR','FAMI_TIENEAUTOMOVIL',\n",
        "            'FAMI_TIENECONSOLAVIDEOJUEGOS','FAMI_TIENEINTERNET',\n",
        "            'FAMI_TIENESERVICIOTV','FAMI_TIENEMOTOCICLETA']:\n",
        "    if col in df.columns:\n",
        "        df[col] = df[col].replace({'Si': True, 'No': False})\n",
        "\n",
        "# 5. Categorías\n",
        "for col in ['ESTU_NACIONALIDAD','ESTU_PAIS_RESIDE','ESTU_AREARESIDE',\n",
        "            'ESTU_GENERO','ESTU_DEPTO_RESIDE','ESTU_MCPIO_RESIDE',\n",
        "            'ESTU_PRGM_ACADEMICO','ESTU_NIVEL_PRGM_ACADEMICO',\n",
        "            'ESTU_METODO_PRGM','INST_CARACTER_ACADEMICO',\n",
        "            'INST_ORIGEN','MOD_INGLES_DESEM']:\n",
        "    if col in df.columns and df[col].dtype == 'object':\n",
        "        df[col] = df[col].astype('category')\n",
        "\n",
        "df"
